# Copiez ce fichier vers `.env` à la racine du projet, puis renseignez les valeurs.
#
# Base de données PostgreSQL : NEON (sans mise en pause après 7 jours)
# - DATABASE_URL : chaîne de connexion Pooled (`-pooler`) avec `?sslmode=require&connect_timeout=15`
# - DIRECT_URL   : chaîne de connexion Directe (sans `-pooler`) pour Prisma Migrate avec `?sslmode=require&connect_timeout=15`
#
# Exemple Neon :
# DATABASE_URL="postgresql://neondb_owner:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# DIRECT_URL="postgresql://neondb_owner:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_files,read_orders,read_products,write_files,write_products
SHOPIFY_APP_URL=https://sar-bundle.vercel.app
DATABASE_URL=
DIRECT_URL=
